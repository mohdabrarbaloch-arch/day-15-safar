# ------------------------------------------------------------
# Safar - environment configuration
# Copy to .env and fill in. Nothing here is a real secret; all values
# below are development defaults.
# ------------------------------------------------------------

# --- Application ----------------------------------------------
# "development" enables the seeded demo account and permissive logs.
# "production" refuses to boot with a weak JWT_SECRET or a wildcard CORS origin.
ENVIRONMENT=development
APP_NAME=Safar
APP_VERSION=1.0.0

# --- Security -------------------------------------------------
# Signing key for JWTs (HS256). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED in production. Must be >= 32 characters there or startup fails.
JWT_SECRET=dev-only-insecure-secret-change-me-please-0000000000
JWT_ALGORITHM=HS256
# Token lifetime in minutes (default 24 h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database -------------------------------------------------
# SQLite is the default and needs no server:
DATABASE_URL=sqlite:///./safar.db
# PostgreSQL via docker-compose:
# DATABASE_URL=postgresql+psycopg2://safar:safar_dev_password@db:5432/safar

# --- CORS -----------------------------------------------------
# Comma-separated list of allowed origins. "*" is rejected in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Rate limiting --------------------------------------------
# Sliding-window budget, per client IP.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_SIM_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Simulation defaults --------------------------------------
# Fixed integration step in seconds. Smaller = more accurate, slower.
SIM_DT=0.05
# Hard ceiling on simulated duration, in seconds, per run.
SIM_MAX_DURATION=120
# Hard ceiling on frames returned to the client (keeps payloads sane).
SIM_MAX_FRAMES=4000

# --- Demo data ------------------------------------------------
# Seed a demo account on first boot. Ignored when ENVIRONMENT=production.
SEED_DEMO=true
DEMO_EMAIL=demo@safar.pk
DEMO_PASSWORD=safar-demo-2026

# --- Server ---------------------------------------------------
HOST=0.0.0.0
PORT=8000
